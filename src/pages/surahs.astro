---
import Layout from '@/layouts/layout.astro'
import Card from '@/components/cards/card-common.astro'
import ChartSurah from '@/components/charts/chart-surah'
import ChartSurahDistribution from '@/components/charts/chart-surah-distribution'
---

<Layout>
  <h1 class="text-3xl">Surahs</h1>
  <p class="text-muted-foreground">Statistics of Surahs (Chapters) of Al-Qur'an.</p>

  <div class="flex flex-col gap-4">
    <Card title="Surahs Stats" description="Number of Ayahs in each Surah">
      <ChartSurah client:load />
    </Card>
    <Card title="Distribution of Surahs by Juz'" description="How the Surahs spread across the 30 Juz, by share of each Juz">
      <ChartSurahDistribution client:load />
    </Card>
  </div>
</Layout>