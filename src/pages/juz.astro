---
import Layout from '@/layouts/layout.astro'
import Card from '@/components/cards/card-common.astro'
import ChartJuz from '@/components/charts/chart-juz'
import ChartHizb from '@/components/charts/chart-hizb'
import ChartRub from "@/components/charts/chart-rub'"
---

<Layout>
  <h1 class="text-3xl">Juz</h1>
  <p class="text-muted-foreground">Statistics of Juz. Al-Qur'an is divided into 30 Juz, 60 Hizb, and 240 Rub' al-Hizb.</p>

  <div class="flex flex-col gap-4">
    <Card title="Juz Stats" description="Number of Surahs and Ayahs in each Juz">
      <ChartJuz client:load />
    </Card>
    <Card title="Hizb Stats" description="Number of Ayahs in each Hizb (half of a Juz). The Qur'an has 60 Hizb.">
      <ChartHizb client:load />
    </Card>
    <Card title="Rub' al-Hizb Stats" description="Number of Ayahs in each Rub' al-Hizb (a quarter of a Hizb). The Qur'an has 240 Rub'.">
      <ChartRub client:load />
    </Card>
  </div>
</Layout>
